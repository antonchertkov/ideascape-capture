{
  "name": "IdeaScape Capture",
  "short_name": "Capture",
  "description": "Get an idea onto your IdeaScape canvas in seconds.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0f0c18",
  "theme_color": "#0f0c18",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "shortcuts": [
    { "name": "Voice idea", "short_name": "Voice", "url": "./?mic=1", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "Photo idea", "short_name": "Photo", "url": "./?cam=1", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "media", "accept": ["image/*"] }]
    }
  }
}
